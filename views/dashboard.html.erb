<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="refresh" content="300">
    <title>RunPod GPU availability</title>
    <meta name="description" content="Historical RunPod Serverless GPU availability by region, pool, and hourly price.">
    <link rel="canonical" href="https://animesh-runpod-gpu-availability.fly.dev/">
    <meta property="og:title" content="RunPod GPU availability">
    <meta property="og:description" content="Historical RunPod Serverless GPU availability by region, pool, and hourly price.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://animesh-runpod-gpu-availability.fly.dev/">
    <meta property="og:site_name" content="RunPod GPU availability">
    <meta property="og:image" content="https://raw.githubusercontent.com/Animesh-Ghosh/runpod-gpu-availability/main/docs/dashboard.png">
    <meta property="og:image:alt" content="RunPod GPU availability dashboard">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="RunPod GPU availability">
    <meta name="twitter:description" content="Historical RunPod Serverless GPU availability by region, pool, and hourly price.">
    <meta name="twitter:image" content="https://raw.githubusercontent.com/Animesh-Ghosh/runpod-gpu-availability/main/docs/dashboard.png">
    <style>
      :root { color-scheme: light dark; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
      body { max-width: 1400px; margin: 2rem auto; padding: 0 1rem; }
      .page-header { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; } .page-header h1 { margin: 0; }
      table { border-collapse: collapse; width: 100%; margin: 1rem 0 2rem; font-size: .9rem; }
      th, td { padding: .55rem; border-bottom: 1px solid #7774; text-align: left; white-space: nowrap; }
      th { position: sticky; top: 0; background: Canvas; }
      .HIGH { color: #14833b; font-weight: 700; } .MEDIUM { color: #b06d00; font-weight: 700; }
      .LOW { color: #b5410e; font-weight: 700; } .UNKNOWN { color: #777; }
      .muted { opacity: .72; } .warning { color: #b5410e; } .configurations { white-space: normal; min-width: 18rem; }
      .configurations summary { cursor: pointer; } .configurations ul { margin: .4rem 0 0; padding-left: 1.2rem; }
      .chart-wrap { overflow-x: auto; border: 1px solid #7774; padding: .75rem; }
      svg { display: block; min-width: 850px; width: 100%; } .region-label { font-size: 13px; fill: currentColor; }
      .axis-label { font-size: 11px; fill: currentColor; opacity: .72; }
      .legend { display: flex; gap: 1rem; flex-wrap: wrap; } .swatch { display: inline-block; width: .8rem; height: .8rem; margin-right: .25rem; }
    </style>
  </head>
  <body>
    <header class="page-header">
      <h1>RunPod GPU availability</h1>
      <a href="https://github.com/Animesh-Ghosh/runpod-gpu-availability" target="_blank" rel="noopener noreferrer">GitHub repository</a>
    </header>
    <p class="<%= snapshot ? "muted" : "warning" %>"><%= h(status_message) %></p>
    <p class="muted">Snapshots every 1 hour at UTC.<% if snapshot %> · Last successful snapshot: <%= h(captured_at) %>.<% end %></p>
    <p class="<%= latest_capture_error ? "warning" : "muted" %>"><%= h(latest_capture_run_message) %><% if latest_capture_error %> <span class="warning"><%= h(latest_capture_error) %></span><% end %></p>

    <h2>History: last <%= days %> days</h2>
    <p><a href="/?days=7">7 days</a> · <a href="/?days=28">28 days</a> · <a href="/?days=90">90 days</a></p>
    <h3>Region status timeline</h3>
    <p class="muted">Each cell is the best availability RunPod advertised for any Serverless GPU configuration in that region at that capture. No cell means no advertised configuration was recorded; it is not proof of zero capacity.</p>
    <p class="legend"><span><i class="swatch" style="background:#22c55e"></i>High</span><span><i class="swatch" style="background:#f59e0b"></i>Medium</span><span><i class="swatch" style="background:#ef4444"></i>Low</span><span><i class="swatch" style="background:#94a3b8"></i>Unknown</span></p>
    <%= AvailabilityChart.new(statuses: region_statuses).render %>

    <h3>Historical region summary</h3>
    <p class="muted">Best and worst are the region's best advertised configuration at each capture, over the selected period.</p>
    <% if region_availability_summaries.empty? %>
      <p>No historical regional availability rows recorded.</p>
    <% else %>
      <table><thead><tr><th>Region</th><th>Observed best</th><th>Observed worst</th><th>Snapshots</th><th>High</th><th>Medium</th><th>Low</th><th>Unknown</th></tr></thead><tbody>
        <% region_availability_summaries.each do |record| %>
          <tr><td><%= h(record["region_id"]) %></td><td class="<%= h(record["best_availability"]) %>"><%= h(record["best_availability"]) %></td><td class="<%= h(record["worst_availability"]) %>"><%= h(record["worst_availability"]) %></td><td><%= record["snapshots_observed"] %></td><td><%= record["high_snapshots"] %></td><td><%= record["medium_snapshots"] %></td><td><%= record["low_snapshots"] %></td><td><%= record["unknown_snapshots"] %></td></tr>
        <% end %>
      </tbody></table>
    <% end %>

    <h2>Current region status</h2>
    <% if current_regions.empty? %>
      <p>No regional availability rows in the latest snapshot.</p>
    <% else %>
      <table><thead><tr><th>Region</th><th>Best availability</th><th>Worst availability</th><th>Advertised configurations</th><th>Last observed $/hour</th><th>Observed price range</th></tr></thead><tbody>
        <% current_regions.each do |record| %>
          <tr><td><%= h(record["region_id"]) %></td><td class="<%= h(record["availability"]) %>"><%= h(record["availability"]) %></td><td class="<%= h(record["worst_availability"]) %>"><%= h(record["worst_availability"]) %></td><td class="configurations"><details><summary><%= record["configurations"].length %> configuration<%= 's' unless record["configurations"].one? %></summary><ul><% record["configurations"].each do |configuration| %><li><%= h(configuration["gpu_name"]) %> · <span class="<%= h(configuration["availability"]) %>"><%= h(configuration["availability"]) %></span></li><% end %></ul></details></td><td><%= h(price(record["last_observed_price_usd_per_hour"])) %></td><td><%= h(price_range(record)) %></td></tr>
        <% end %>
      </tbody></table>
    <% end %>
  </body>
</html>
